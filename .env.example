PROJECT_NAME=eiko-direct
CONTAINER_NAME=eiko-direct-app
NEXT_PUBLIC_API_URL=http://localhost:8100
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_TIMEOUT=10000
NEXT_PUBLIC_API_RETRIES=0
NEXT_PUBLIC_API_RETRY_DELAY=1000
NEXT_PUBLIC_INTERNAL_API_URL=http://eiko-app:80
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:74321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# LIFF Configuration
NEXT_PUBLIC_LIFF_ID=your-liff-id
NEXT_PUBLIC_ENABLE_LIFF=false
NEXT_PUBLIC_USE_MOCK_LIFF=true

# LINE Platform Configuration (for Edge Functions)
LINE_LIFF_ID=your-liff-id