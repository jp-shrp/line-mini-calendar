{
    "name": "eiko-direct",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "source .env && dotenv -e .env -- next dev -p ${PORT:-8081}",
        "build": "next build",
        "start": "next start",
        "lint": "next lint && (cd .server && npx eslint src --ext .ts)",
        "type-check": "tsc --noEmit && (cd .server && tsc --noEmit)",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "mock:dev": "cd .server && npm run dev",
        "mock:build": "cd .server && npm run build",
        "mock:start": "cd .server && npm run start",
        "mock:install": "cd .server && npm install"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "@playwright/test": "^1.55.0",
        "@react-oauth/google": "^0.12.2",
        "@tanstack/react-query": "^5.85.5",
        "@team-decorate/alcts": "^2.1.8",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "dotenv-cli": "^8.0.0",
        "express": "^5.1.0",
        "jotai": "^2.12.5",
        "js-cookie": "^3.0.5",
        "next": "15.3.2",
        "react": "^19.0.0",
        "react-calendar": "^6.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.60.0",
        "zod": "^4.1.9"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@faker-js/faker": "^9.9.0",
        "@tailwindcss/postcss": "^4",
        "@testing-library/jest-dom": "^6.8.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "15.3.2",
        "eslint-plugin-unused-imports": "^4.1.4",
        "jest": "^30.1.3",
        "jest-environment-jsdom": "^30.1.2",
        "nodemon": "^3.1.10",
        "prettier": "^3.5.3",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "tailwindcss": "^4",
        "ts-jest": "^29.4.3",
        "ts-node": "^10.9.2",
        "typescript": "^5"
    }
}
