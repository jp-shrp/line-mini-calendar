{
    "browser": {
        "browserName": "chromium",
        "isolated": true,
        "userDataDir": "/tmp/playwright-user-data",
        "launchOptions": {
            "headless": true,
            "args": ["--no-sandbox", "--disable-dev-shm-usage"]
        },
        "contextOptions": {
            "viewport": {
                "width": 1920,
                "height": 1080
            },
            "locale": "ja-JP",
            "timezoneId": "Asia/Tokyo"
        }
    },
    "outputDir": "/tmp/playwright-output"
}
